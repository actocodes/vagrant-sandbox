# Generated by vagrant-sandbox. Edit settings through the config or CLI.
require "fileutils"

VM_NAME = @@VM_NAME@@
VM_IP = @@VM_IP@@
VM_CPUS = @@VM_CPUS@@
VM_MEMORY = @@VM_MEMORY@@

Vagrant.configure("2") do |config|
  config.vm.box = @@BOX@@
  config.vm.hostname = VM_NAME

  # Keep project files on the host isolated from the guest.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.forward_agent = false
  config.ssh.forward_x11 = false
  config.vm.network "private_network", ip: VM_IP

  config.vm.provider "virtualbox" do |vb|
    vb.name = VM_NAME
    vb.cpus = VM_CPUS
    vb.memory = VM_MEMORY
    vb.linked_clone = true
    vb.customize ["modifyvm", :id, "--clipboard-mode", "disabled"]
    vb.customize ["modifyvm", :id, "--draganddrop", "disabled"]
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["numvcpus"] = VM_CPUS.to_s
    vmware.vmx["memsize"] = VM_MEMORY.to_s
    vmware.vmx["isolation.tools.copy.disable"] = "TRUE"
    vmware.vmx["isolation.tools.paste.disable"] = "TRUE"
    vmware.vmx["isolation.tools.dnd.disable"] = "TRUE"
  end

  config.vm.provider "parallels" do |parallels|
    parallels.cpus = VM_CPUS
    parallels.memory = VM_MEMORY
  end

@@PROVISIONERS@@

  config.trigger.after :up, :reload do |trigger|
    trigger.name = "vagrant-sandbox SSH config"
    trigger.info = "Updating SSH config for sandbox-#{VM_NAME}"
    trigger.ruby do |_env, machine|
      ssh_info = machine.ssh_info
      raise "Vagrant did not provide SSH connection details." unless ssh_info

      host_alias = "sandbox-#{VM_NAME}"
      config_path = File.expand_path("~/.ssh/config")
      FileUtils.mkdir_p(File.dirname(config_path))
      existing = File.exist?(config_path) ? File.read(config_path) : ""
      line_ending = existing.include?("\r\n") ? "\r\n" : "\n"
      begin_marker = "# BEGIN vagrant-sandbox #{host_alias}"
      end_marker = "# END vagrant-sandbox #{host_alias}"
      block_pattern = /^#{Regexp.escape(begin_marker)}\r?\n.*?^#{Regexp.escape(end_marker)}\r?\n?/m

      if existing.include?(begin_marker) || existing.include?(end_marker)
        unless existing.scan(begin_marker).length == 1 &&
            existing.scan(end_marker).length == 1 &&
            block_pattern.match?(existing)
          raise "The managed SSH config block for #{host_alias} is malformed."
        end
        existing = existing.sub(block_pattern, "")
      end

      quote = lambda do |value|
        '"' + value.to_s.gsub(/(["\\])/) { |character| "\\#{character}" } + '"'
      end
      identity_paths = Array(ssh_info[:private_key_path])
      raise "Vagrant did not provide an SSH identity file." if identity_paths.empty?

      lines = [
        begin_marker,
        "Host #{host_alias}",
        "  HostName #{quote.call(ssh_info.fetch(:host))}",
        "  User #{quote.call(ssh_info.fetch(:username))}",
        "  Port #{ssh_info.fetch(:port)}",
        *identity_paths.map { |path| "  IdentityFile #{quote.call(path)}" },
        "  IdentitiesOnly #{ssh_info[:keys_only] ? "yes" : "no"}",
        end_marker,
      ]
      ssh_block = lines.join(line_ending)
      updated = if existing.empty?
        ssh_block + line_ending
      else
        ssh_block + line_ending * 2 + existing
      end
      File.write(config_path, updated)
    end
  end

  config.vm.post_up_message = <<-MSG
    Sandbox '#{VM_NAME}' is up at #{VM_IP}.
    Clone repositories into ~/workspace inside the VM, host folders are not shared.
    VS Code Remote-SSH host: sandbox-#{VM_NAME}
  MSG
end
