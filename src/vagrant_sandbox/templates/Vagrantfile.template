# Generated by vagrant-sandbox. Edit settings through the config or CLI.
require "base64"
require "fileutils"
require "open3"
require "rbconfig"

VM_NAME = @@VM_NAME@@
VM_IP = @@VM_IP@@
VM_CPUS = @@VM_CPUS@@
VM_MEMORY = @@VM_MEMORY@@

def vagrant_sandbox_update_hosts(action)
  begin_marker = "# BEGIN vagrant-sandbox #{VM_NAME}"
  end_marker = "# END vagrant-sandbox #{VM_NAME}"
  if Gem.win_platform?
    powershell = <<~POWERSHELL
      $ErrorActionPreference = "Stop"
      $path = Join-Path $env:SystemRoot "System32\\drivers\\etc\\hosts"
      $action = "#{action}"
      $beginMarker = "#{begin_marker}"
      $endMarker = "#{end_marker}"
      $vmName = "#{VM_NAME}"
      $vmIp = "#{VM_IP}"
      $content = [System.IO.File]::ReadAllText($path)
      $newline = if ($content.Contains("`r`n")) { "`r`n" } else { "`n" }
      $hasBegin = $content.Contains($beginMarker)
      $hasEnd = $content.Contains($endMarker)
      $pattern = "(?ms)^" + [regex]::Escape($beginMarker) + "\\r?\\n.*?^" +
        [regex]::Escape($endMarker) + "\\r?\\n?"
      if ($hasBegin -or $hasEnd) {
        if (-not ($hasBegin -and $hasEnd) -or
            [regex]::Matches($content, [regex]::Escape($beginMarker)).Count -ne 1 -or
            [regex]::Matches($content, [regex]::Escape($endMarker)).Count -ne 1 -or
            -not [regex]::IsMatch($content, $pattern)) {
          throw "The managed hosts entry for $vmName is malformed."
        }
        $content = [regex]::Replace($content, $pattern, "", 1)
      }
      if ($action -eq "add") {
        foreach ($line in ($content -split "\\r?\\n")) {
          if ($line -match "^\\s*[^#\\s]" -and
              ($line -split "\\s+" | Select-Object -Skip 1) -contains $vmName) {
            throw "A hosts entry for $vmName already exists outside its managed block."
          }
        }
        $block = "$beginMarker$newline$vmIp $vmName$newline$endMarker$newline"
        if ($content.Length -eq 0) {
          $content = $block
        } else {
          $separator = if ($content.EndsWith($newline)) { "" } else { $newline }
          $content = $content + $separator + $newline + $block
        }
      }
      if ($content -cne [System.IO.File]::ReadAllText($path)) {
        [System.IO.File]::WriteAllText(
          $path,
          $content,
          [System.Text.UTF8Encoding]::new($false)
        )
      }
    POWERSHELL
    encoded_script = Base64.strict_encode64(powershell.encode("UTF-16LE"))
    launcher = <<~POWERSHELL
      try {
        $process = Start-Process -FilePath "powershell.exe" -Verb RunAs -Wait -PassThru `
          -ArgumentList "-NoProfile -ExecutionPolicy Bypass -EncodedCommand #{encoded_script}"
        exit $process.ExitCode
      } catch {
        Write-Error $_
        exit 1
      }
    POWERSHELL
    command = ["powershell.exe", "-NoProfile", "-Command", launcher]
  else
    hosts_path = "/etc/hosts"
    update_script = <<~'RUBY'
      path, action, begin_marker, end_marker, vm_ip, vm_name = ARGV
      content = File.binread(path)
      newline = content.include?("\r\n") ? "\r\n" : "\n"
      has_begin = content.include?(begin_marker)
      has_end = content.include?(end_marker)
      pattern = /^#{Regexp.escape(begin_marker)}\r?\n.*?^#{Regexp.escape(end_marker)}\r?\n?/m

      if has_begin || has_end
        unless has_begin && has_end &&
            content.scan(begin_marker).length == 1 &&
            content.scan(end_marker).length == 1 &&
            pattern.match?(content)
          raise "The managed hosts entry for #{vm_name} is malformed."
        end
        content = content.sub(pattern, "")
      end

      if action == "add"
        conflict = content.each_line.any? do |line|
          !line.lstrip.start_with?("#") && line.split(/\s+/).drop(1).include?(vm_name)
        end
        raise "A hosts entry for #{vm_name} already exists outside its managed block." if conflict

        block = "#{begin_marker}#{newline}#{vm_ip} #{vm_name}#{newline}#{end_marker}#{newline}"
        if content.empty?
          content = block
        else
          separator = content.end_with?(newline) ? "" : newline
          content = "#{content}#{separator}#{newline}#{block}"
        end
      end

      File.binwrite(path, content)
    RUBY
    command = [
      "sudo",
      RbConfig.ruby,
      "-e",
      update_script,
      hosts_path,
      action,
      begin_marker,
      end_marker,
      VM_IP,
      VM_NAME,
    ]
  end

  stdout, stderr, status = Open3.capture3(*command)
  return if status.success?

  details = [stderr, stdout].reject(&:empty?).join("\n").strip
  message = "Could not #{action} the vagrant-sandbox hosts entry"
  message += ": #{details}" unless details.empty?
  raise message
end

Vagrant.configure("2") do |config|
  config.vm.box = @@BOX@@
  config.vm.hostname = VM_NAME

  # Keep project files on the host isolated from the guest.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.forward_agent = false
  config.ssh.forward_x11 = false
  config.vm.network "private_network", ip: VM_IP

  config.vm.provider "virtualbox" do |vb|
    vb.name = VM_NAME
    vb.cpus = VM_CPUS
    vb.memory = VM_MEMORY
    vb.linked_clone = true
    vb.customize ["modifyvm", :id, "--clipboard-mode", "disabled"]
    vb.customize ["modifyvm", :id, "--draganddrop", "disabled"]
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["numvcpus"] = VM_CPUS.to_s
    vmware.vmx["memsize"] = VM_MEMORY.to_s
    vmware.vmx["isolation.tools.copy.disable"] = "TRUE"
    vmware.vmx["isolation.tools.paste.disable"] = "TRUE"
    vmware.vmx["isolation.tools.dnd.disable"] = "TRUE"
  end

  config.vm.provider "parallels" do |parallels|
    parallels.cpus = VM_CPUS
    parallels.memory = VM_MEMORY
  end

@@PROVISIONERS@@

  config.trigger.after :up, :reload do |trigger|
    trigger.name = "vagrant-sandbox SSH config"
    trigger.info = "Updating SSH config for sandbox-#{VM_NAME}"
    trigger.ruby do |_env, machine|
      ssh_info = machine.ssh_info
      raise "Vagrant did not provide SSH connection details." unless ssh_info

      host_alias = "sandbox-#{VM_NAME}"
      config_path = File.expand_path("~/.ssh/config")
      FileUtils.mkdir_p(File.dirname(config_path))
      existing = File.exist?(config_path) ? File.read(config_path) : ""
      line_ending = existing.include?("\r\n") ? "\r\n" : "\n"
      begin_marker = "# BEGIN vagrant-sandbox #{host_alias}"
      end_marker = "# END vagrant-sandbox #{host_alias}"
      block_pattern = /^#{Regexp.escape(begin_marker)}\r?\n.*?^#{Regexp.escape(end_marker)}\r?\n?/m

      if existing.include?(begin_marker) || existing.include?(end_marker)
        unless existing.scan(begin_marker).length == 1 &&
            existing.scan(end_marker).length == 1 &&
            block_pattern.match?(existing)
          raise "The managed SSH config block for #{host_alias} is malformed."
        end
        existing = existing.sub(block_pattern, "")
      end

      quote = lambda do |value|
        '"' + value.to_s.gsub(/(["\\])/) { |character| "\\#{character}" } + '"'
      end
      identity_paths = Array(ssh_info[:private_key_path])
      raise "Vagrant did not provide an SSH identity file." if identity_paths.empty?

      lines = [
        begin_marker,
        "Host #{host_alias}",
        "  HostName #{quote.call(ssh_info.fetch(:host))}",
        "  User #{quote.call(ssh_info.fetch(:username))}",
        "  Port #{ssh_info.fetch(:port)}",
        *identity_paths.map { |path| "  IdentityFile #{quote.call(path)}" },
        "  IdentitiesOnly #{ssh_info[:keys_only] ? "yes" : "no"}",
        end_marker,
      ]
      ssh_block = lines.join(line_ending)
      updated = if existing.empty?
        ssh_block + line_ending
      else
        ssh_block + line_ending * 2 + existing
      end
      File.write(config_path, updated)
    end
  end

  config.trigger.after :up, :reload do |trigger|
    trigger.name = "vagrant-sandbox host DNS"
    trigger.info = "Adding #{VM_NAME} to the host hosts file"
    trigger.ruby do
      vagrant_sandbox_update_hosts("add")
    end
  end

  config.trigger.after :destroy do |trigger|
    trigger.name = "vagrant-sandbox host DNS cleanup"
    trigger.info = "Removing #{VM_NAME} from the host hosts file"
    trigger.ruby do
      vagrant_sandbox_update_hosts("remove")
    end
  end

  config.vm.post_up_message = <<-MSG
    Sandbox '#{VM_NAME}' is up at #{VM_IP}.
    Clone repositories into ~/workspace inside the VM, host folders are not shared.
    VS Code Remote-SSH host: sandbox-#{VM_NAME}
  MSG
end
